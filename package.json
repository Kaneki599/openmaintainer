{
  "name": "openmaintainer",
  "version": "0.1.0",
  "private": false,
  "description": "Explainable maintainer health checks for GitHub repositories.",
  "type": "module",
  "bin": {
    "openmaintainer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "scan": "tsx src/cli.ts scan"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github",
    "security",
    "maintainers",
    "github-actions",
    "open-source"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
