{
  "name": "openmaintainer",
  "version": "0.2.4",
  "private": false,
  "description": "Explainable maintainer health checks for GitHub repositories.",
  "type": "module",
  "bin": {
    "openmaintainer": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:action": "esbuild src/action.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/action.cjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "scan": "tsx src/cli.ts scan",
    "prepack": "npm run build && npm run bundle:action && npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github",
    "security",
    "maintainers",
    "github-actions",
    "open-source"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaneki599/openmaintainer.git"
  },
  "bugs": {
    "url": "https://github.com/Kaneki599/openmaintainer/issues"
  },
  "homepage": "https://github.com/Kaneki599/openmaintainer#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
